{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "minisat",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/fuzz",
      "args": [
        "temp.cnf",
        "temp.proof"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build minisat"
    }
  ]
}